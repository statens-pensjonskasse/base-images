ARG OS_VERSION=9
ARG OS_TYPE=-minimal
FROM rockylinux/rockylinux:${OS_VERSION}${OS_TYPE}

# Magical variable that is set to amd64 for linux/amd64 platform and arm64 for linux/arm64 platform
ARG OS_VERSION
ARG OS_TYPE
ARG TARGETARCH
ARG PACKAGE_MANAGER=microdnf
ARG PACKAGE_MANAGER_FLAGS="--assumeyes --nodocs --setopt=install_weak_deps=0"
ARG COMMON_PACKAGES="glibc-langpack-en shadow-utils"
ARG DISTRO_SPECIFIC_PACKAGES=""
ARG MICROSOFT_REPO_NAME='MS_Prod_EL'

ENV TZ=Europe/Oslo
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && \
    echo ${TZ} > /etc/timezone

# Add script for enabling internal Yum repositories and disabling mirrorlists
COPY yum-switch-to-internal-repos.sh /usr/local/bin/

# shadow-utils are needed for `useradd`, which is missing in 8-minimal (but not in 9-minimal)
# Also adds EPEL-repo
RUN ${PACKAGE_MANAGER} ${PACKAGE_MANAGER_FLAGS} update && \
    ${PACKAGE_MANAGER} ${PACKAGE_MANAGER_FLAGS} install \
        ${COMMON_PACKAGES} \
        ${DISTRO_SPECIFIC_PACKAGES} \
        epel-release && \
    ${PACKAGE_MANAGER} clean all && \
    rm -rf /var/cache/yum

# Install yum repositories for Docker and Microsoft
RUN curl -sSL -o /etc/yum.repos.d/docker-ce.repo https://download.docker.com/linux/rhel/docker-ce.repo
RUN curl -sSL -O https://packages.microsoft.com/config/rhel/${OS_VERSION}/packages-microsoft-prod.rpm \
    && rpm -ivh ./packages-microsoft-prod.rpm \
    && rm -f packages-microsoft-prod.rpm

# Fetch and install current root certificate from github
ADD --chmod=644 https://raw.githubusercontent.com/statens-pensjonskasse/internal-ca-certificates/refs/heads/main/spk-root-ca.pem /etc/pki/ca-trust/source/anchors/
RUN update-ca-trust extract

# Temporary workaround for eMudhra Intermediate CA Compromise (ref https://emudhra.we-have-a-problem.com/)
# Can be removed once Rocky Linux ca-certificates package has been updated
RUN d=/etc/pki/ca-trust/source/blocklist; [ -d $d ] || d=/etc/pki/ca-trust/source/blacklist && \
    trust extract --overwrite --format=pem-bundle \
    --filter='pkcs11:object=Comodo%20AAA%20Services%20root;type=cert' \
    $d/Comodo_AAA_Services_root.pem && \
    trust extract --overwrite --format=pem-bundle \
    --filter='pkcs11:object=emSign%20ECC%20Root%20CA%20-%20G3;type=cert' \
    $d/emSign_ECC_Root_CA_-_G3.pem && \
    update-ca-trust

# Evaluate templates for internal Yum repositories
# Put them in /etc/yum.repos-internal.d so they can be enabled by the enable-internal-yum-repos.sh script
RUN --mount=type=bind,src=repos,dst=/tmp/repos \
    if [ "${TARGETARCH}" = "amd64" ]; then \
        ARCH=x86_64; \
    elif [ "${TARGETARCH}" = "arm64" ]; then \
        ARCH=aarch64; \
    else \
        echo "Error: Target architecture '${TARGETARCH}' is not supported" && \
        exit 1; \
    fi; \
    mkdir -p /etc/yum.repos-internal.d; \
    for REPO in /tmp/repos/*; do \
        eval "echo \"$(cat ${REPO})\"" > /etc/yum.repos-internal.d/$(basename ${REPO} .tmpl); \
    done;

# Set locale
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

RUN adduser app

USER app
WORKDIR /home/app
