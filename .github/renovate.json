{
  "extends": [
    "github>statens-pensjonskasse/renovate-presets:recommended.json",
    "github>statens-pensjonskasse/renovate-presets:renovate-comments(\\.yaml$,(\\.yml$))"
  ],
  "packageRules": [
    {
      "description": "Only allow patch updates from GitHub tags",
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["golang/go"],
      "allowedVersions": "<{{major}}.{{add minor 1}}.0"
    }
  ]
}
